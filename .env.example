# --- LLM provider -----------------------------------------------------------
# One of: demo | google | openai
LLM_PROVIDER=demo
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0

# --- Embeddings -------------------------------------------------------------
# One of: hashing | google | openai   (hashing = deterministic, no API key)
EMBEDDING_PROVIDER=hashing

# --- FalkorDB ---------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=novatech
# One of: auto | falkor | memory
# auto = use FalkorDB when reachable, otherwise fall back to the in-process
# graph store (tests / offline demos). FalkorDB is always preferred.
GRAPH_BACKEND=auto

# --- Runtime ---------------------------------------------------------------
DEMO_MODE=true
CACHE_URL=
VECTOR_STORE_PATH=./var/vector_store.json
ACTIONS_STORE_PATH=./var/actions.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
